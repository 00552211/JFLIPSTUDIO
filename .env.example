# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (Client Credentials) — サーバー側のみで使用。NEXT_PUBLIC_ を付けないこと
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar（スタジオの公開カレンダー）— サーバー側のみ。NEXT_PUBLIC_ を付けないこと
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Gemini API（無料枠。Instagram DM自動返信の文章生成） https://aistudio.google.com でキー発行
GEMINI_API_KEY=

# Instagram DM自動返信 — Meta for Developersアプリの設定値（Instagramログインによる API設定）
# INSTAGRAM_VERIFY_TOKEN: Webhook登録時に自分で決める好きな文字列（Meta側の設定と一致させる）
# INSTAGRAM_ACCESS_TOKEN: 「Instagramログインによる API設定」で発行するInstagram User Access Token
# INSTAGRAM_APP_SECRET: Meta Appダッシュボード「設定 > 基本設定」のApp Secret（Webhook署名検証に使用。
#   Instagram API設定ページに表示される「Instagram app secret」とは別物なので注意）
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
