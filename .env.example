# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (Client Credentials) — サーバー側のみで使用。NEXT_PUBLIC_ を付けないこと
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar（スタジオの公開カレンダー）— サーバー側のみ。NEXT_PUBLIC_ を付けないこと
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# 池袋店の空き状況カレンダー（Square）— サーバー側のみ。NEXT_PUBLIC_ を付けないこと
# LOCATION_ID は「CONNECT Studio 池袋」、SERVICE_VARIATION_ID は最短プラン（1h）のサービスバリエーションID
SQUARE2_ACCESS_TOKEN=
SQUARE2_LOCATION_ID=
SQUARE2_SERVICE_VARIATION_ID=
