# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (Client Credentials) — サーバー側のみで使用。NEXT_PUBLIC_ を付けないこと
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar（スタジオの公開カレンダー）— サーバー側のみ。NEXT_PUBLIC_ を付けないこと
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# 2号店を公開するか。"true" のときだけ、店舗切り替えと2号店の内容がサイトに出る（未設定=非公開）
NEXT_PUBLIC_STORE2_ENABLED=

# 2号店（別のSquareアカウント）— サーバー側のみ。NEXT_PUBLIC_ を付けないこと
# 空き状況カレンダー用。SERVICE_VARIATION_ID は最短プラン（60分）のサービスバリエーションID
SQUARE2_ACCESS_TOKEN=
SQUARE2_LOCATION_ID=
SQUARE2_SERVICE_VARIATION_ID=
# 2号店のSquare予約ページURL（公開URLなのでNEXT_PUBLIC_でよい）。未設定の間はInstagram DMへ誘導
NEXT_PUBLIC_STORE2_BOOKING_URL=

